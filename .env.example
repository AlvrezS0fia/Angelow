# ============================================================
# ANGELOW - Plantilla de configuración (.env.example)
# Copia este archivo a `.env` y completa los valores reales.
# NUNCA subas `.env` real a Git (ya está en .gitignore).
# ============================================================

# Database Configuration
DB_HOST=db
DB_NAME=angelow_db
DB_USER=root
DB_PASS=root

# SMTP Configuration for EmailService
SMTP_HOST=smtp.gmail.com
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_PORT=587
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME=Angelow

# Application Configuration
APP_NAME=Angelow
APP_URL=http://localhost:8080
TIMEZONE=America/Bogota

# Google OAuth (if needed)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# JWT signing key used to sign/verify repartidor authentication tokens.
# Genera una clave segura, por ejemplo con:
#   php -r "echo base64_encode(random_bytes(32));"
# IMPORTANTE: mantenla en secreto. Si la cambias se invalidan las sesiones activas.
JWT_SECRET=change_me_to_a_long_random_secret
